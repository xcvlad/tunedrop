# Archivos que git NO debe subir a GitHub.

# Python: cachés y entorno virtual (cada persona crea el suyo con: python -m venv .venv)
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# Secretos (nunca se suben)
.env
.env.*

# Resultados de compilar (se publican en Releases, no en el código)
build/
dist/
*.spec

# Nix: «result» es el enlace que crea «nix build». flake.lock no se sube a
# propósito: así Nix usa siempre la versión más reciente de nixos-unstable
# (y de yt-dlp, que tiene que estar al día para que YouTube funcione).
result
result-*
flake.lock

# Binarios descargados: ffmpeg y deno pesan cientos de MB
bin/

# Audio de pruebas y archivos de diagnóstico
*.mp3
*.m4a
*.opus
*.webm
tunedrop-comprobacion.txt

# Sistema / editores
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
